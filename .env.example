# Sao chép file này thành .env.local và điền thông tin dự án Supabase của bạn.
# CHỈ dùng khoá "anon"/"publishable" (công khai). KHÔNG BAO GIỜ đặt service_role key ở frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Để trống hai biến trên => ứng dụng chạy ở "Chế độ dùng thử" (dữ liệu chỉ lưu trên thiết bị).
